# Environment for the APP project — the deployment whose PRIMARY domain is
# app.gradr.me. Copy these into that project's environment; do NOT set them in
# the marketing project (gradr.me), where they would send every product route
# to a host that hosting redirects straight back.
#
# Why these two variables exist: hosting serves exactly one primary custom
# domain per project and 302s every other connected domain to it. The bundle
# therefore has to be told, at build time, that it *is* the app surface and
# that satellite subdomains are genuinely served.

# Renders the app surface at "/" on every host this bundle runs on — including
# the project's *.lovable.app preview URL, so app.gradr.me can be verified
# before DNS is switched over.
VITE_GRADR_SURFACE=app

# Tells cross-surface links and the OAuth helpers that app.gradr.me is served
# independently, so authCallbackUrl() and the post-login landing resolve to
# https://app.gradr.me/ instead of falling back to the current origin.
VITE_APP_SUBDOMAIN_LIVE=true

# Backend binding — identical to the marketing project. Both surfaces share one
# Lovable Cloud backend so sessions, RLS and entitlements are the same.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-publishable-key>

# Payments (Paddle) — same values as the marketing project.
VITE_PAYMENTS_ENVIRONMENT=production
VITE_PAYMENTS_CLIENT_TOKEN=<paddle-client-token>

# Analytics — same PostHog project, so the funnel spans both surfaces.
VITE_LOVABLE_CONNECTOR_POSTHOG_API_KEY=<posthog-key>
VITE_LOVABLE_CONNECTOR_POSTHOG_PROJECT_ID=<posthog-project-id>
VITE_LOVABLE_CONNECTOR_POSTHOG_REGION=<posthog-region>

# ---------------------------------------------------------------------------
# Backend redirect configuration that must match this project
# ---------------------------------------------------------------------------
# In the shared Lovable Cloud backend, the auth Site URL must be
#   https://app.gradr.me
# and the redirect allow-list must include:
#   https://app.gradr.me/**
#   https://app.gradr.me/~oauth/callback
#   https://gradr.me/**            (marketing sign-in entry points)
#   http://localhost:8080/**       (local development)
#
# Google Cloud console → OAuth client → Authorised redirect URIs must contain
# the managed broker callback plus:
#   https://app.gradr.me/~oauth/callback
#
# Verify the result with: node scripts/check-app-serving.mjs
