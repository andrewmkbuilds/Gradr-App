# --- Lovable Cloud (Supabase) ---------------------------------------------
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon-publishable-key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# --- Payments (Paddle) -----------------------------------------------------
# Environment is NEVER defaulted. Must be "sandbox" or "live" and must match
# the client token prefix (test_ => sandbox, live_ => live).
VITE_PAYMENTS_ENVIRONMENT="sandbox"
# Client-side token only. The server-side API key must never be in client code.
VITE_PAYMENTS_CLIENT_TOKEN="test_xxxxxxxxxxxxxxxxxxxxxxxxx"

# Server-side only (edge function secrets, never exposed to the browser):
#   PADDLE_SANDBOX_API_KEY
#   PADDLE_LIVE_API_KEY
#   PAYMENTS_SANDBOX_WEBHOOK_SECRET   <- webhook notification SIGNING secret
#   PAYMENTS_LIVE_WEBHOOK_SECRET

# --- Surface / domain routing ---------------------------------------------
# Hosting serves exactly ONE primary domain per Lovable project; every other
# connected domain 302s to it at the edge. To serve a subdomain directly you
# create a separate project whose PRIMARY domain is that subdomain, and pin the
# surface it renders:
#
#   VITE_GRADR_SURFACE="app"     -> project whose primary domain is app.gradr.me
#   VITE_GRADR_SURFACE="docs"    -> docs.gradr.me
#   ... one of: home app marketing news docs affiliates status support
#
# The pinned surface renders at "/" on every host that build runs on, including
# its *.lovable.app preview URL — so it can be verified before DNS is moved.
#
# LEAVE THIS UNSET in this project. Unset = today's behaviour: hostname routing
# in production, path prefixes on shared hosts.
# VITE_GRADR_SURFACE=""
