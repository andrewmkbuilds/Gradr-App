#!/bin/sh
# Gradr pre-commit guard.
#
# Blocks the commit when the architecture guard finds any forbidden TanStack
# Start reference — in dependencies, lockfiles, source imports, or build
# artifacts. Bypass only with an explicit `git commit --no-verify`.
set -e

echo "pre-commit: running TanStack Start guard…"
if ! node scripts/check-no-tanstack.mjs; then
  echo ""
  echo "Commit blocked: Gradr must stay on Vite + React Router."
  echo "Remove the TanStack Start reference(s) above, or re-run with --no-verify if you are certain."
  exit 1
fi

echo "pre-commit: checks passed."
