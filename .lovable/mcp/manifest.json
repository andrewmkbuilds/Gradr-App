              "description": "New pipeline status (e.g. 'saved', 'applied', 'interview', 'offer', 'rejected')."
            },
            "notes": {
              "type": "string",
              "description": "Replace the job's notes."
            },
            "applied_at": {
              "type": "string",
              "description": "ISO timestamp for when the user applied."
            }
          },
          "required": [
            "id"
