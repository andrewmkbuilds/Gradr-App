            "salary_max": {
              "type": "number"
            },
            "description": {
              "type": "string",
              "description": "Full job description text."
            },
            "notes": {
              "type": "string"
            },
            "source": {
              "type": "string",
              "description": "Where this job came from (e.g. 'linkedin', 'manual')."
            }
