{
  "$comment": "Single source of truth for Gradr 'Yacht Club' brand metadata. Consumed by the admin brand-metadata inspector, the CI crawler, the OG image hash verifier and the build-time legacy-brand scan. Update this file when branding changes — never hardcode expectations in the checkers.",
  "brand": {
    "name": "Gradr",
    "siteTitle": "Gradr | AI Career Copilot for Resumes, Jobs & Interviews",
    "description": "AI career copilot for resumes, job matches, and interviews — all in one Gradr workspace.",
    "origin": "https://gradr.me",
    "themeColor": "#245F73",
    "backgroundColor": "#0f2a33",
    "palette": {
      "offWhite": "#F2F0EF",
      "gray": "#BBBDBC",
      "teal": "#245F73",
      "mahogany": "#733E24"
    }
  },
  "ogVersion": "2026-08-yachtclub",
  "defaultOgImage": "/og-image.jpg",
  "manifestPath": "/site.webmanifest",
  "manifest": {
    "name": "Gradr | AI Career Copilot for Resumes, Jobs & Interviews",
    "short_name": "Gradr",
    "description": "AI career copilot for resumes, job matches, and interviews — all in one Gradr workspace.",
    "theme_color": "#245F73",
    "background_color": "#0f2a33",
    "start_url": "/",
    "requiredIcons": ["/favicon.png", "/apple-touch-icon.png", "/icon-192.png", "/icon-512.png"]
  },
  "icons": ["/favicon.png", "/apple-touch-icon.png", "/icon-192.png", "/icon-512.png"],
  "routes": [
    { "path": "/", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/landing", "ogImage": "/og/landing.png", "indexable": true },
    { "path": "/pricing", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/ai-interview-coach", "ogImage": "/og/ai-interview-coach.png", "indexable": true },
    { "path": "/ats-resume-checker", "ogImage": "/og/ats-resume-checker.png", "indexable": true },
    { "path": "/ai-resume-builder", "ogImage": "/og/ai-resume-builder.png", "indexable": true },
    { "path": "/blog", "ogImage": "/og/blog.png", "indexable": true },
    { "path": "/blog/ai-resume-optimization", "ogImage": "/og/blog-ai-resume-optimization.png", "indexable": true },
    { "path": "/career-advice", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/terms", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/privacy", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/cookie-policy", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/refund-policy", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/dpa", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/status", "ogImage": "/og-image.jpg", "indexable": true },
    { "path": "/auth", "ogImage": "/og-image.jpg", "indexable": false }
  ],
  "forbidden": {
    "$comment": "Legacy identity that must never ship again in public HTML, metadata or public assets.",
    "strings": [
      "CareerFlow OS",
      "CareerFlow",
      "careerflowos",
      "careerflow-os",
      "careerflow",
      "HireOS",
      "Lovable Generated Project",
      "Lovable App"
    ],
    "ogFilenames": [
      "og-careerflow.png",
      "careerflow-og.png",
      "og-image-v1.jpg",
      "og-image-v1.png",
      "og-hireos.png",
      "careerflow-social.png"
    ],
    "$allowlistComment": "Paths excluded from the legacy-brand scan (history, this spec, and the checkers that must name the forbidden strings).",
    "allowlist": [
      "src/config/brand-spec.json",
      "scripts/brand-scan.mjs",
      "scripts/brand-metadata-ci.mjs",
      "scripts/og-image-verify.mjs",
      "src/lib/edge/brand-metadata.server.ts",
      "src/pages/AdminBrandMetadata.tsx",
      ".lovable/",
      "supabase/migrations/"
    ]
  }
}
